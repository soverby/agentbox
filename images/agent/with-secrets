#!/bin/sh
# with-secrets: export each /run/secrets/<NAME> as NAME, then exec "$@".
# (docs/PLAN.md §2.1, §2.4)
# - Only regular files (not symlinks) whose name matches
#   ^[A-Za-z_][A-Za-z0-9_]*$. Others are skipped silently.
# - Value = exact file bytes minus ONE trailing newline, if present.
#   (A shell variable cannot hold a NUL byte; such a value is truncated.)
# - Reserved names (docs/PLAN.md §2.4: PATH, LD_*, proxy vars, BASH_ENV,
#   GIT_*, TLS CA overrides, ...) are never exported, in any letter case.
#   Exception: MCP_GATEWAY_TOKEN, AGENTBOX_*, ANTHROPIC_* are allowed,
#   because the CLI itself delivers them as secrets.
# - Files larger than 128 KiB are skipped with a warning (name only).
# - Values are never printed.
# - Missing /run/secrets: no-op.
set -u
__ws_dir=/run/secrets
__ws_nl='
'
if [ -d "$__ws_dir" ]; then
  for __ws_f in "$__ws_dir"/*; do
    [ -f "$__ws_f" ] && [ ! -L "$__ws_f" ] || continue
    __ws_name=${__ws_f##*/}
    case $__ws_name in
      [A-Za-z_]*) ;;
      *) continue ;;
    esac
    case $__ws_name in
      *[!A-Za-z0-9_]*) continue ;;
    esac
    __ws_upper=$(printf '%s' "$__ws_name" | tr '[:lower:]' '[:upper:]')
    case $__ws_upper in
      __WS_*|PATH|HOME|USER|SHELL|LD_*|*_PROXY|NPM_CONFIG_*|NODE_*|PYTHON*|\
      OLLAMA_HOST|DISABLE_AUTOUPDATER|DISABLE_UPDATES|\
      ENABLE_CLAUDEAI_MCP_SERVERS|CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC|\
      BASH_ENV|ENV|IFS|PS4|SSL_CERT_*|CURL_CA_BUNDLE|REQUESTS_CA_BUNDLE|GIT_*)
        continue ;;
    esac
    [ -r "$__ws_f" ] || continue
    __ws_size=$(wc -c < "$__ws_f") || continue
    if [ "$__ws_size" -gt 131072 ]; then
      echo "with-secrets: skipped $__ws_name (larger than 128 KiB)" >&2
      continue
    fi
    # The trailing "x" keeps $(...) from stripping trailing newlines.
    __ws_value=$(cat -- "$__ws_f" && printf x) || continue
    __ws_value=${__ws_value%x}
    __ws_value=${__ws_value%"$__ws_nl"}
    export "$__ws_name=$__ws_value"
  done
fi
unset __ws_dir __ws_nl __ws_f __ws_name __ws_upper __ws_value __ws_size
exec "$@"
